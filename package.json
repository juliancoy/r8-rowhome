{
  "name": "r8-rowhome",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:documents": "node scripts/generate-documents-index.mjs",
    "assets:sketchfab": "python3 scripts/download-sketchfab-assets.py",
    "predev": "npm run generate:documents",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run generate:documents",
    "build": "tsc && vite build",
    "browser:smoke": "python3 scripts/run-browser-smoke.py",
    "benchmark:renderers": "python3 scripts/run-renderer-benchmark.py",
    "structural:gravity": "node scripts/run-structural-gravity.mjs && vitest run tests/structural-gravity.test.ts",
    "hvac:fem": "node scripts/run-hvac-fem.mjs && vitest run tests/hvac-flow-report.test.ts",
    "plumbing:fluid": "node scripts/run-plumbing-fluid.mjs && vitest run tests/plumbing-flow-report.test.ts",
    "permit:readiness": "node scripts/run-permit-readiness.mjs && vitest run tests/permit-readiness.test.ts",
    "deficiencies:resolve": "node scripts/run-deficiency-resolution.mjs && vitest run tests/deficiency-resolution.test.ts",
    "construction:preflight": "node scripts/run-construction-documents.mjs && vitest run tests/construction-documents.test.ts",
    "collision:audit": "node scripts/run-collision-audit.mjs && vitest run tests/collision-audit.test.ts",
    "print:preflight": "node scripts/run-print-preflight.mjs && vitest run tests/print-preflight.test.ts",
    "documents:organize": "node scripts/run-document-organization.mjs && vitest run tests/document-organization.test.ts",
    "livability:walkthrough": "node scripts/run-livability-walkthrough.mjs && vitest run tests/livability-walkthrough.test.ts",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  }
}
