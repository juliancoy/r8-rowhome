{
  "name": "r8-rowhome",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:documents": "node scripts/generate-documents-index.mjs",
    "predev": "npm run generate:documents",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run generate:documents",
    "build": "tsc && vite build",
    "browser:smoke": "python3 scripts/run-browser-smoke.py",
    "structural:gravity": "node scripts/run-structural-gravity.mjs && vitest run tests/structural-gravity.test.ts",
    "hvac:fem": "node scripts/run-hvac-fem.mjs && vitest run tests/hvac-flow-report.test.ts",
    "plumbing:fluid": "node scripts/run-plumbing-fluid.mjs && vitest run tests/plumbing-flow-report.test.ts",
    "preview": "vite preview --host 0.0.0.0",
    "pretest": "npm run generate:documents",
    "test": "vitest run"
  },
  "dependencies": {
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  }
}
